{
  "name": "@shipdocs/viewer-core",
  "version": "0.1.0",
  "private": true,
  "description": "The ship viewer every ship runs: its UI, its data loading and its Vite config. Ships hold only their data and generated code.",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./customize": "./src/customize.ts",
    "./diagram": "./src/shared/diagram/index.ts",
    "./objects": "./src/objects/index.ts",
    "./objects/model3d": "./src/objects/ObjectModel3D.tsx",
    "./catalog": "./src/shared/catalog/index.ts",
    "./data": "./src/shared/data/index.ts",
    "./ui": "./src/shared/ui/index.ts",
    "./styles.css": "./src/styles.css",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./tsconfig.app.json": "./tsconfig.app.json"
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "^8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "typescript": "^5",
    "vite": "^8"
  }
}
