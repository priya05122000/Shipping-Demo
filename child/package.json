{
  "name": "ship-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "The ships' viewers, separate from the Ship Docs app (the parent): their own install, build and deploy.",
  "type": "module",
  "workspaces": [
    "core"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @shipdocs/viewer-core",
    "build": "node scripts/build-ships.mjs",
    "serve": "node scripts/serve-ships.mjs",
    "migrate": "node scripts/migrate-ship.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "typescript": "^5",
    "vite": "^8"
  }
}
