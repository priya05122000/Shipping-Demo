{
  "name": "ship",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "child"
  ],
  "scripts": {
    "dev": "concurrently -n parent,child -c blue,magenta \"next dev\" \"npm run dev -w child\"",
    "dev:parent": "next dev",
    "dev:child": "npm run dev -w child",
    "build": "npm run build -w child && next build",
    "build:standalone": "npm run build:standalone -w child --",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
