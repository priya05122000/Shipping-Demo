{
  "name": "ship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n parent,child -c blue,magenta \"next dev\" \"npm --prefix child run dev\"",
    "dev:parent": "next dev",
    "dev:child": "npm --prefix child run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "install:child": "npm --prefix child install",
    "build:ships": "npm --prefix child run build --",
    "serve:ships": "npm --prefix child run serve",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@monaco-editor/loader": "^1.7.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
